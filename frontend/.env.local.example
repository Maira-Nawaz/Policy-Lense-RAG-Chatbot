# Copy this file to .env.local and adjust if needed:
#   cp .env.local.example .env.local
#
# Base URL of the PolicyLens FastAPI backend (api/main.py). Must point at wherever
# that backend is actually running -- localhost for local dev, a deployed URL later.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase project used for Auth (same project the backend already uses).
# The anon key is meant to be public/embedded in frontend code -- unlike
# SUPABASE_SERVICE_KEY in the backend's .env, this is safe to commit here.
NEXT_PUBLIC_SUPABASE_URL=https://bqbkckusofvncvxgexvg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_1xv2vSkB_CuAxYJGEKsacA_DrW8iP26
